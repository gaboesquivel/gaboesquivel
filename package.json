{
  "name": "gaboesquivel",
  "version": "7.2.0",
  "description": "Gabo Esquivel - Product Engineer",
  "author": "Gabo Esquivel",
  "bin": {
    "gaboesquivel": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./content/*": "./dist/content/*",
    "./projects.json": "./dist/projects.json",
    "./tech.json": "./dist/tech.json",
    "./tags.json": "./dist/tags.json",
    "./experience.json": "./dist/experience.json",
    "./cv.json": "./dist/cv.json"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "npm run generate && tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build",
    "hooks:pre-commit": "sh -c 'set -eu; staged=$(git diff --cached --name-only --diff-filter=ACMR); if [ -n \"$staged\" ]; then printf \"%s\\n\" \"$staged\" | xargs bun x ultracite fix; fi' && git update-index --again",
    "skills:install": "bunx skills@latest experimental_install",
    "skills:update": "bunx skills@latest update -p -y",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/prompts": "^2.4.9",
    "fast-glob": "^3.3.0",
    "gray-matter": "^4.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "simple-git-hooks": "2.11.1",
    "tsup": "^8.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.2",
    "ultracite": "8.0.1",
    "zod": "^3.22.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run hooks:pre-commit"
  }
}
